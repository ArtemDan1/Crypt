{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "tray"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:allow-reveal-item-in-dir",
    "autostart:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
